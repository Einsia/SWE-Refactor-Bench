{
 "compile_semantics": {
  "defined_overflow": {
   "any_of": [
    "-fno-strict-overflow",
    "-fwrapv"
   ],
   "why": "AX_CHECK_COMPILE_FLAG([-fno-strict-overflow]) with -fwrapv as its documented fallback"
  },
  "fortify_source": {
   "any_of": [
    "-D_FORTIFY_SOURCE=2",
    "-D_FORTIFY_SOURCE=3",
    "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2",
    "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3"
   ],
   "why": "AX_ADD_FORTIFY_SOURCE on linux-gnu"
  },
  "hidden_visibility": {
   "any_of": [
    "-fvisibility=hidden"
   ],
   "why": "AX_CHECK_COMPILE_FLAG([-fvisibility=hidden]); the exported symbol set depends on it"
  },
  "no_strict_aliasing": {
   "any_of": [
    "-fno-strict-aliasing"
   ],
   "why": "AX_CHECK_COMPILE_FLAG([-fno-strict-aliasing]); the reference implementations rely on it"
  },
  "optimisation": {
   "any_of": [
    "-O2",
    "-O3",
    "-Ofast"
   ],
   "why": "configure.ac probes -O3, then -O2, -O1, -O in turn"
  },
  "position_independent": {
   "any_of": [
    "-fPIC",
    "-fpic",
    "-fPIE",
    "-fpie"
   ],
   "why": "AX_CHECK_COMPILE_FLAG([-fPIC]) / ([-fPIE])"
  },
  "stack_protector": {
   "any_of": [
    "-fstack-protector",
    "-fstack-protector-strong",
    "-fstack-protector-all"
   ],
   "why": "AX_CHECK_COMPILE_FLAG([-fstack-protector]) guarded by --disable-ssp"
  }
 },
 "elf": {
  "bind_now": true,
  "fortify_witnesses": [
   "__explicit_bzero_chk",
   "__memcpy_chk",
   "__memset_chk"
  ],
  "full_relro": true,
  "noexecstack": true
 },
 "state_a_cflags": "-O3 -pthread -fvisibility=hidden -fPIC -fPIE -fno-strict-aliasing -fno-strict-overflow -fstack-protector -Wno-deprecated-declarations -Wno-unknown-pragmas -ftls-model=local-dynamic",
 "state_a_cppflags": "-D_FORTIFY_SOURCE=3",
 "state_a_ldflags": "-pie -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack",
