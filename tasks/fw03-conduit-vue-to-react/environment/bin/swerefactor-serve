#!/usr/bin/env bash
# Serve your own build against the same mock API the oracle uses.
#
#   swerefactor-serve [distDir] [--port N]
#
# distDir defaults to the build output found under /workspace/repo. Build first.
# The API, the fixture data and the static file rules are identical to
# swerefactor-oracle, so anything that differs between the two is your code.
set -euo pipefail

REPO="${SWEREFACTOR_REPO:-/workspace/repo}"
PORT=8081
DIST=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --port) PORT="${2:?--port needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "swerefactor-serve: unknown option '$1'" >&2; exit 2 ;;
    *) DIST="$1"; shift ;;
  esac
done

if [[ -z "$DIST" ]]; then
  DIST="$(node /opt/harness/find-dist.mjs "$REPO" || true)"
fi

if [[ -z "$DIST" || ! -f "$DIST/index.html" ]]; then
  echo "swerefactor-serve: no build output with an index.html found." >&2
  echo "  Run your build first (npm run build), or pass the directory." >&2
  exit 1
fi

exec node /opt/harness/serve.mjs "$DIST" "$PORT" "your build"
