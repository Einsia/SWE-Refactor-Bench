{
  "build_contract": {
    "build": [
      "make",
      "build"
    ],
    "driver": "make wrapping cargo",
    "environment_during_build": {
      "cargo": "offline, via CARGO_NET_OFFLINE and a CARGO_HOME config.toml",
      "discarded_before_build": [
        "target",
        "node_modules",
        "dist",
        ".cargo",
        "vendor"
      ],
      "interpreters": "node, npm, npx, yarn, pnpm, deno, bun, qjs and similar resolve to a tripwire that refuses and records. Unlike the C-compiler shim in the sibling C-to-Rust task there is no forwarded case: a Rust build of a Rust parser has no legitimate use for a JavaScript interpreter.",
      "network": "none",
      "rust_toolchain": "1.90.0, pinned via RUSTUP_TOOLCHAIN"
    },
    "in_source_build": "expected: cargo writes to target/ inside the repository",
    "install": [
      "make",
      "install",
      "PREFIX=<prefix>"
    ],
    "optional_targets": [
      "test",
      "clean"
    ]
  },
  "forbidden_paths": {
    "description": "No file matching these patterns may exist anywhere under the submission root, at any depth, under any name. The JavaScript implementation, its build toolchain and its package metadata all leave the source closure. Out-of-source build directories (target/) are excluded from the check and are discarded before grading.",
    "extensions": [
      ".js",
      ".mjs",
      ".cjs",
      ".jsx",
      ".ts",
      ".mts",
      ".cts",
      ".tsx",
      ".node",
      ".wasm",
      ".map"
    ],
    "names": [
      "package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lockb",
      ".npmrc",
      ".npmignore",
      ".eslintignore",
      ".tern-project",
      "node_modules"
    ],
    "note": "test/bench/fixtures/*.js are third-party JavaScript bundles used as State A benchmark input; they are .js files and go with the rest. The verifier keeps its own copies and feeds them to the submission on stdin."
  },
  "native_code_policy": {
    "allowed_rust_dependencies": "std, core and alloc only. No crates.io dependencies, no git dependencies, no vendored third-party crates, no build scripts that download or generate code from outside the submission. Workspace members may depend on each other.",
    "description": "Every byte of executable code in the delivered binaries must be produced by the pinned Rust toolchain from Rust sources inside the submission.",
    "forbidden_build_actions": [
      "running node, npm, npx, yarn, pnpm, deno or bun at build time",
      "compiling or bundling JavaScript in any form",
      "linking a prebuilt object file, static archive or shared library that ships inside the submission",
      "reaching the network"
    ],
    "min_rust_logic_lines": 4000,
    "rust_edition_max": "2024",
    "rust_toolchain": "1.90.0"
  },
  "probe_protocol": {
    "binary": "acorn-probe",
    "operations": [
      "version",
      "default_options",
      "token_types",
      "keyword_types",
      "parse",
      "parse_collect",
      "parse_expression_at",
      "tokenize",
      "loose_parse",
      "walk_full",
      "walk_full_ancestor",
      "walk_simple",
      "walk_recursive",
      "find_node_at",
      "find_node_around",
      "find_node_after",
      "find_node_before",
      "get_line_info",
      "is_identifier_start",
      "is_identifier_char",
      "is_new_line",
      "line_break_test",
      "nonascii_whitespace_test"
    ],
    "response_key_order": [
      "id",
      "ok",
      "result",
      "error"
    ],
    "specification": "instruction.md, section 'The probe protocol'",
    "transport": "NDJSON on stdin/stdout, one request per line, one response per line, in order"
  },
  "product": {
    "name": "acorn",
    "packages": [
      "acorn 8.14.0",
